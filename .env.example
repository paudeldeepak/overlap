# Copy this file to .env and change what you need. docker compose reads .env automatically.

# Port Overlap listens on, inside the container and on the host. Point Caddy at the same one.
PORT=8080

# Host address the port is published on. Keep 127.0.0.1 when Caddy runs on the same machine,
# so nobody can reach Overlap without going through Caddy.
BIND=127.0.0.1

# 1 when Caddy (or another reverse proxy) sits in front and sets X-Forwarded-* headers.
# Set it to 0 only if you expose Overlap directly, without a proxy.
TRUST_PROXY=1
